{
	"name": "ff7-for-st-jude",
	"displayName": "FF7 for St. Jude",
	"description": "FF7 for St. Jude - Raising money for St. Jude through speedrunning Final Fantasy 7.",
	"version": "10.5.0",
	"main": "bundle.js",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://ff7forstjude.org",
	"scripts": {
		"generate:dev": "node scripts/src-generate.js && npx prettier --write src/index.html",
		"generate:dist": "node scripts/dist-generate.js && npx prettier --write dist/index.html --ignore-path /dev/null",
		"generate:public": "node scripts/public-generate.js && npx prettier --write public/manifest.json",
		"build": "vite build && npm run generate:dist && npm run generate:public",
		"dev": "npm run generate:public && npm run generate:dev && vite --host",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
		"lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --quiet",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.135",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@tanstack/react-query-devtools": "^5.103.2",
		"@tanstack/router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.40",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "17.12.0",
		"prettier": "^3.9.6",
		"sass": "^1.104.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vite-plugin-sitemap": "^0.8.2"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.38",
		"immer": "^11.1.18",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-error-boundary": "^6.1.6",
		"react-router-dom": "^7.18.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/displaycoffee/ff7-for-st-jude.git"
	},
	"bugs": {
		"url": "https://github.com/displaycoffee/ff7-for-st-jude/issues"
	},
	"browserslist": [
		"last 2 versions"
	]
}
